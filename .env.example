# ---------------------------------------------------------------------------
# Which stack does `docker compose up` run?
#
# This one variable is the switch between local development and a
# production-shaped run. Nothing else needs to change.
#
#   development (default):     docker-compose.yml:docker-compose.dev.yml
#   production, bare IP:       docker-compose.yml
#   production, real domain:   docker-compose.yml:docker-compose.proxy.yml
#
# Development adds bind-mounted source, watch mode, published datastore ports
# and the `dev` image target. Bare-IP production uses compiled images only,
# with the UI published directly on UI_PORT. The proxy variant additionally
# puts Caddy in front for automatic Let's Encrypt TLS (see ./Caddyfile) and
# stops publishing the UI and MinIO ports directly — only Caddy is public.
# A bind mount cannot be switched off by a variable, which is why these are
# separate files rather than one file with more conditions.
# ---------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Ports published on the host in production (COMPOSE_FILE=docker-compose.yml).
UI_PORT=80
API_PORT=7000
# Real inbound mail only ever arrives on 25 — receiving servers don't
# negotiate a different port. Keep this at 25 for a real deployment; the
# lower default here just avoids demanding a privileged port for anyone who
# runs the "production" compose file locally without meaning to receive mail.
SMTP_PORT=25
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Ports published on the host in development, so the two modes never collide.
UI_DEV_PORT=3000
API_DEV_PORT=3001
# Mailpit (dev only): catches outbound mail so delivery can be tested without
# a real domain or port-25 access. Web UI at http://localhost:8025. Its own
# SMTP port defaults to 1026 on the host — drive-osx-mail's inbound listener
# already claims 1025 (SMTP_PORT above); inside the Compose network
# drive-osx-mail still reaches Mailpit on its real port, 1025.
MAILPIT_SMTP_PORT=1026
MAILPIT_WEB_PORT=8025
# The dev http->https redirect (see drive-osx-ui/scripts/dev-https-redirect.js)
# — catches a bare host typed with no scheme/port, which otherwise lands on
# plain port 80 instead of the https app on UI_DEV_PORT.
UI_DEV_REDIRECT_PORT=80

# PostgreSQL — the platform's source of truth.
POSTGRES_USER=drive
POSTGRES_PASSWORD=drive
POSTGRES_DB=drive
# Published on the host in development only, for running services outside Docker.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Object storage (MinIO locally; S3/R2/GCS in other environments).
MINIO_ROOT_USER=driveosx
MINIO_ROOT_PASSWORD=driveosx-secret
STORAGE_BUCKET=drive-osx
# Host the browser uses to redeem signed storage URLs. Must be reachable by
# every user's browser, not just this machine: localhost only works for
# whoever is on the same machine as the server. If other people use this
# deployment over a LAN or the internet, set this to this machine's LAN IP
# or public hostname instead, or attachments/images/media will fail to load
# for everyone but you. Behind docker-compose.proxy.yml, this must be
# https://storage.<your domain> — that's the Caddy-fronted hostname MinIO is
# actually reachable on, not the internal minio:9000 the API itself uses.
STORAGE_PUBLIC_URL=http://localhost:9000

# Cross-service invariant, not a variable this file sets:
# MAIL_GATEWAY_TOKEN must hold the same value in drive-osx-api/.env and
# drive-osx-mail/.env. It is the SMTP gateway's proof of origin for inbound
# mail, which carries no user session — and, in reverse, the API's proof of
# origin when it hands off outbound mail to drive-osx-mail's relay port
# (MAIL_GATEWAY_URL in drive-osx-api/.env, pointed at drive-osx-mail:2526 by
# docker-compose.yml). Service secrets live in the service's own .env (as
# JWT_SECRET does), so it is not duplicated here.
# Verify both sides with: ./scripts/check-env.sh

# Baked into the UI bundle at build time. The relative path is correct whenever
# the shell is served behind the bundled nginx, which proxies /api to the API.
VITE_API_BASE_URL=/api/v1
